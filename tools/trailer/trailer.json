 "music": [
  {
   "t": 0.0,
   "section": "rain",
   "bpm": null,
   "notes": "No score. Rain City bed fades up from silence: rain, far traffic, a murmur of the crowd."
  },
  {
   "t": 1.5,
   "section": "hook · AFTERZERO main theme, intimate",
   "bpm": 78,
   "notes": "Felt piano alone: the three-note motif E-B-A (Kai and Mira's shared memory), rubato, lots of air. A low cello pedal joins at 7.5. Breath-like texture, no drums. Minor mode with a suspended chord."
  },
  {
   "t": 17.5,
   "section": "approach",
   "bpm": 78,
   "notes": "A muted low piano ostinato starts to drift off the grid (Kai's \"need to fix it\" cell); bowed metal swells under the train horn pair (311 / 370 Hz, from the game)."
  },
  {
   "t": 19.75,
   "section": "SILENCE · the Zero Second",
   "bpm": null,
   "notes": "One second of digital silence: rain, crowd and score all stop (bible section 7, silence as storytelling)."
  },
  {
   "t": 20.75,
   "section": "the held second",
   "bpm": null,
   "notes": "Free time: glass harmonics, a sub drone, the causal-consequence resonance; nothing on the beat."
  },
  {
   "t": 27.75,
   "section": "Mira · memory without a body",
   "bpm": 64,
   "notes": "The motif on felt piano, closer and warmer, one warm cello harmonic; unresolved. A reversed tail, used once."
  },
  {
   "t": 32.25,
   "section": "the voice",
   "bpm": null,
   "notes": "Everything drops to a low sub and one sustained cello note under the voice."
  },
  {
   "t": 35.0,
   "section": "world · main theme expands",
   "bpm": 78,
   "notes": "Piano motif plus low strings in octaves; slowly expanding; every cut lands on a beat."
  },
  {
   "t": 45.0,
   "section": "world · the past",
   "bpm": 78,
   "notes": "Frame drum on beats 1 and 3, breathy flute counter-line, plucked strings and water texture for the valley (no cultural pastiche)."
  },
  {
   "t": 55.75,
   "section": "world · night glass",
   "bpm": 78,
   "notes": "Glass tones and sparse piano for the observatory night and the clockmaker; strings hold."
  },
  {
   "t": 61.167,
   "section": "world · beautiful catastrophe",
   "bpm": 78,
   "notes": "Wide strings, distant brass, processed wind; sparse piano; no heavy drums (bible 2196 cue)."
  },
  {
   "t": 68.833,
   "section": "the Witness",
   "bpm": 54,
   "notes": "The motif slower and lower in bowed bass and bowed metal, irregular pulse; the three glass taps are its last notes."
  },
  {
   "t": 72.708,
   "section": "card · breath",
   "bpm": null,
   "notes": "Near silence; one reversed glass swell rises into the montage downbeat."
  },
  {
   "t": 75.0,
   "section": "montage · the Nine-Minute War",
   "bpm": 118,
   "notes": "Precise layered percussion (frame drum, low toms, ticks), short string ostinati; every 7th bar slips by an eighth; brief gaps and reversed impacts before hits; no trailer booms."
  },
  {
   "t": 87.208,
   "section": "montage · half-bar cuts",
   "bpm": 118,
   "notes": "All layers; the string ostinato doubles; a reversed impact before every second cut; the last bar thins to ticks alone."
  },
  {
   "t": 97.375,
   "section": "SILENCE",
   "bpm": null,
   "notes": "Hard stop: 1.2 s of digital silence."
  },
  {
   "t": 98.583,
   "section": "title · main theme reprise",
   "bpm": 78,
   "notes": "Piano motif alone, then cello; strings bloom under the tagline; the hopeful suspended chord on the title card, its top note left unresolved."
  },
  {
   "t": 109.583,
   "section": "button",
   "bpm": null,
   "notes": "Only diegetic sound: ring hum, Iven's voice, the switch stinger, then silence on the cut."
  },
  {
   "t": 112.083,
   "section": "end card",
   "bpm": null,
   "notes": "One low piano A ringing out under a rain tail; fade over the last second."
